# ─────────────────────────────────────────────────────────────
# LSI site environment variables
# Copy to .env.local for local dev; set the same keys in Render.
# The site runs without any of these — providers skip gracefully —
# but quote submissions are only persisted/delivered once they're set.
# ─────────────────────────────────────────────────────────────

# Postgres (Render → "Internal Database URL"). Enables DB persistence.
DATABASE_URL=

# Resend (email notifications) — https://resend.com
RESEND_API_KEY=
# Verified sender, e.g. "LSI Quotes <quotes@yourdomain.com>"
# Defaults to Resend's onboarding@resend.dev sandbox if unset.
QUOTE_FROM_EMAIL=
# Where new-quote emails are delivered (the shop owner).
SHOP_NOTIFICATION_EMAIL=

# Linq (SMS/text notifications) — https://docs.linqapp.com
LINQ_API_KEY=
# Your Linq-provisioned sending number in E.164 format, e.g. +14155550123
LINQ_FROM_NUMBER=
# Owner's phone that receives the text alert, E.164 format.
SHOP_NOTIFICATION_PHONE=
# Optional override; defaults to Linq's Partner API endpoint.
# LINQ_API_URL=https://api.linqapp.com/api/partner/v3/chats
